{
  "compilerOptions": {
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "sourceMap": true,
    "lib": ["dom", "es2022"]
  },
  // "include": ["src/**/*"],
  // "exclude": ["node_modules", "dist"]
}
